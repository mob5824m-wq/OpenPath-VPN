# Copy to .env.sub and fill — for SUB host DuckDNS
# cp .env.duckdns.sub.example .env.sub && nano .env.sub

# Each SUB host gets its OWN DuckDNS domain (e.g., openpath-sub1 / openpath-tor / openpath-asia)
# Create at https://www.duckdns.org — add domain, copy token (same token for all your domains)
SUB_DUCKDNS_DOMAIN=openpath-sub1
DUCKDNS_DOMAIN=openpath-sub1
DUCKDNS_TOKEN=replace-with-your-duckdns-token

# Sub host settings
PORT=4434
HOST=0.0.0.0
ROLE=sub
MAIN_URL=http://main-ip:4433
# Or for public main: MAIN_URL=https://openpath-main.duckdns.org
HOST_NAME=OpenPath Sub Montreal
HOST_REGION=ca-east
HOST_COUNTRY=CA
HOST_FLAG=🇨🇦

# PSK must match main's PSK (or use demo default)
DEMO_PSK=demo-student-key-do-not-use-prod
OPS_PATH=/ops

# Public URL clients will use (auto-built from duckdns, or set manually)
# For duckdns, wss will be wss://openpath-sub1.duckdns.org/ops on 443 via Caddy
PUBLIC_WSS=wss://openpath-sub1.duckdns.org/ops
PUBLIC_HOST=openpath-sub1.duckdns.org

# Caddy
ACME_DNS=http
