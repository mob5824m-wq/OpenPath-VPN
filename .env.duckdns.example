# Copy to .env and fill in — never commit your real token!
# cp .env.duckdns.example .env && nano .env

# DuckDNS (from https://www.duckdns.org — token at top of page)
DUCKDNS_DOMAIN=openpath42
DUCKDNS_TOKEN=replace-with-your-duckdns-token

# OpenPath server
OPS_PATH=/ops
PORT=4433
HOST=0.0.0.0
DEMO_PSK=demo-student-key-do-not-use-prod
DECOY_TITLE=Alex Rivera — Photography Portfolio
DECOY_SUBTITLE=Toronto — Available for freelance
LOG_LEVEL=info

# Caddy ACME mode:
#   http   = HTTP-01 challenge (needs port 80 reachable, default)
#   duckdns = DNS-01 challenge via DuckDNS API (no port 80 needed, needs DUCKDNS_TOKEN set in caddy env)
ACME_DNS=http
# If ACME_DNS=duckdns, also set CADDY_DUCKDNS_TOKEN same as DUCKDNS_TOKEN (caddy reads it separately)

# Optional: for DNS-01 via DuckDNS, uncomment:
# CADDY_DUCKDNS_TOKEN=${DUCKDNS_TOKEN}

# Optional: override public URL shown in logs/QR
PUBLIC_URL=wss://openpath42.duckdns.org/ops
