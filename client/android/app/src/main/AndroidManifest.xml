<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <application
        android:name=".OpenPathApplication"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:label="OpenPath VPN"
        android:icon="@drawable/ic_launcher"
        android:usesCleartextTraffic="false"
        android:theme="@style/OpenPathTheme">
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Merge with the official library's BIND_VPN_SERVICE declaration. This
             client does not restore a tunnel after the process is killed. -->
        <service android:name="com.wireguard.android.backend.GoBackend$VpnService">
            <meta-data android:name="android.net.VpnService.SUPPORTS_ALWAYS_ON" android:value="false" />
        </service>
    </application>
</manifest>
